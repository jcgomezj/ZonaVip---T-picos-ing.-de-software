# =============================================================================
# ZonaVip — Variables de Entorno para Producción (.env.example)
#
# Copia este archivo a `.env` y configura los valores seguros antes de
# ejecutar: docker compose up -d --build
# =============================================================================

# Django Monolito
# Genera una clave con:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-super-secreta-y-aleatoria-en-produccion-minimo-50-caracteres
DJANGO_DEBUG=False
# IMPORTANTE en EC2: incluye la IP elástica (o el dominio). Si el host con el
# que entras no está aquí, Django responde "400 Bad Request".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<IP-ELASTICA>
# Necesario si usas HTTPS, un dominio o un puerto distinto al 80 (con esquema).
DJANGO_CSRF_TRUSTED_ORIGINS=http://<IP-ELASTICA>
ENV_TYPE=PROD

# Base de Datos (PostgreSQL)
# docker-compose usa estas tres variables tanto para crear la base de datos
# como para que Django se conecte (no uses DJANGO_DB_*: compose las fija).
# Ojo: la contraseña solo se aplica la PRIMERA vez que se crea el volumen.
POSTGRES_DB=zonavip
POSTGRES_USER=zonavip
POSTGRES_PASSWORD=generar_password_segura_de_postgres
DJANGO_DB_CONN_MAX_AGE=600

# Administrador que crea `docker compose exec django_web python manage.py seed_demo`.
# Si dejas la contraseña vacía, se genera una aleatoria y se muestra una vez.
ZONAVIP_ADMIN_USER=admin
ZONAVIP_ADMIN_EMAIL=admin@zonavip.co
ZONAVIP_ADMIN_PASSWORD=

# Correo (opcional). Sin EMAIL_HOST los correos se imprimen en
# `docker compose logs django_web`. Con Gmail: EMAIL_HOST=smtp.gmail.com y una
# "contraseña de aplicación" de Google en EMAIL_HOST_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Zona VIP <no-reply@zonavip.co>"

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Microservicio QR Estrangulado (Flask)
QR_SECRET=generar_secreto_aleatorio_para_firmas_qr

# Microservicio de Integración Estrangulado (Flask)
INTEGRACION_SERVICE_URL=http://flask_integracion:5001
ALIADO_API_URL=
HTTP_TIMEOUT=5

# --- Entrega 3: pagos, reservas y check-in ---
# Pasarela de pagos: SIMULADO (por defecto, sin cobros reales).
PAGOS_MODE=SIMULADO
# Minutos que una reserva sin pagar retiene el cupo antes de expirar.
RESERVA_TTL_MINUTOS=15
# Check-in: True = solo se acepta el QR dinámico (anti captura de pantalla).
CHECKIN_EXIGIR_QR_DINAMICO=False
# Producción detrás de HTTPS: cookies seguras / redirección a HTTPS.
DJANGO_SECURE_COOKIES=False
DJANGO_SSL_REDIRECT=False
